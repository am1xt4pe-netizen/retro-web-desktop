<% @title = "WebDesktop Builder - Create Your Retro Web Desktop" %>
<% @body_class = "landing-page" %>

<div class="landing-container">
  <div class="landing-header">
    <h1>WebDesktop Builder</h1>
    <p class="tagline">Create your own customizable web desktop and publish it as a PWA</p>
    <p class="subtitle">Inspired by Neocities webdesktops like oldmixtape.neocities.org</p>
  </div>

  <div class="landing-features">
    <div class="feature">
      <div class="feature-icon">🖥️</div>
      <h3>Customizable Desktop</h3>
      <p>Drag and drop icons, choose backgrounds, customize every detail</p>
    </div>
    <div class="feature">
      <div class="feature-icon">📁</div>
      <h3>Files & Folders</h3>
      <p>Upload files, create folders, organize your desktop</p>
    </div>
    <div class="feature">
      <div class="feature-icon">🖼️</div>
      <h3>Photo Gallery</h3>
      <p>Add image galleries to showcase your photos</p>
    </div>
    <div class="feature">
      <div class="feature-icon">📝</div>
      <h3>Text Editor</h3>
      <p>Write documents with save and PDF export functionality</p>
    </div>
    <div class="feature">
      <div class="feature-icon">🎮</div>
      <h3>Retro Games</h3>
      <p>Embed Internet Archive retro PC games</p>
    </div>
    <div class="feature">
      <div class="feature-icon">📱</div>
      <h3>PWA Ready</h3>
      <p>Publish as installable Progressive Web App</p>
    </div>
  </div>

  <div class="landing-cta">
    <a href="/signup" class="btn btn-primary">Get Started</a>
    <a href="/login" class="btn btn-secondary">Sign In</a>
  </div>

  <div class="landing-preview">
    <div class="desktop-preview">
      <div class="preview-taskbar">
        <span class="start-btn">Start</span>
        <span class="clock">12:00 PM</span>
      </div>
      <div class="preview-icons">
        <div class="preview-icon">
          <div class="preview-icon-img">📁</div>
          <span>My Files</span>
        </div>
        <div class="preview-icon">
          <div class="preview-icon-img">🖼️</div>
          <span>Photos</span>
        </div>
        <div class="preview-icon">
          <div class="preview-icon-img">📝</div>
          <span>Notes</span>
        </div>
        <div class="preview-icon">
          <div class="preview-icon-img">🎮</div>
          <span>Games</span>
        </div>
      </div>
    </div>
  </div>
</div>
