<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title><%= h doc['title'] %> - PDF Export</title>
  <style>
    @media print {
      body { font-family: Georgia, serif; line-height: 1.6; }
      .no-print { display: none; }
    }
    body { max-width: 800px; margin: 0 auto; padding: 40px; font-family: Georgia, serif; }
    h1 { border-bottom: 2px solid #333; padding-bottom: 10px; }
    .meta { color: #666; font-size: 14px; margin-bottom: 20px; }
    .content { line-height: 1.8; }
    .print-btn {
      position: fixed; top: 20px; right: 20px;
      padding: 10px 20px; background: #0078d7; color: white;
      border: none; border-radius: 4px; cursor: pointer;
    }
  </style>
</head>
<body>
  <button class="print-btn no-print" onclick="window.print()">🖨️ Print / Save as PDF</button>
  <h1><%= h doc['title'] %></h1>
  <div class="meta">Created: <%= doc['created_at'] %> | Last updated: <%= doc['updated_at'] %></div>
  <!-- Rich-text content from the WYSIWYG editor is rendered as HTML by design. -->
  <div class="content"><%= doc['content'] %></div>
</body>
</html>
