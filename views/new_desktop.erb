<% @title = "New Desktop - WebDesktop Builder" %>

<div class="app-layout">
  <aside class="sidebar">
    <div class="sidebar-header">
      <h2>WebDesktop</h2>
    </div>
    <nav class="sidebar-nav">
      <a href="/dashboard" class="nav-item">My Desktops</a>
      <a href="/desktop/new" class="nav-item active">New Desktop</a>
    </nav>
    <div class="sidebar-footer">
      <span class="user-name"><%= h current_user['username'] %></span>
      <a href="/logout" class="logout-link">Logout</a>
    </div>
  </aside>

  <main class="main-content">
    <header class="page-header">
      <h1>Create New Desktop</h1>
      <a href="/dashboard" class="btn btn-secondary">← Back</a>
    </header>

    <form action="/desktop/new" method="POST" class="desktop-form">
      <div class="form-group">
        <label for="name">Desktop Name</label>
        <input type="text" id="name" name="name" required placeholder="My Awesome Desktop">
        <small>This will be the title of your web desktop</small>
      </div>
      <button type="submit" class="btn btn-primary">Create Desktop</button>
    </form>
  </main>
</div>
